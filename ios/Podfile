# whisper_ggml's pod requires iOS 15.6; everything else follows it.
platform :ios, '15.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Dynamic frameworks keep whisper_ggml and llama_ggml as separate images so
  # each vendored ggml copy stays inside its own dylib instead of colliding at
  # static link time.
  use_frameworks! :linkage => :dynamic

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.6'

      # Do not set GCC_PREPROCESSOR_DEFINITIONS here. Assigning it at target
      # level shadows the pod's own xcconfig, and whisper_ggml carries
      # GGML_USE_METAL there — losing it would quietly drop inference back to
      # the CPU rather than fail the build.

      next unless ['whisper_ggml', 'llama_ggml'].include?(target.name)

      config.build_settings['GCC_SYMBOLS_PRIVATE_EXTERN'] = 'YES'
      config.build_settings['USE_HEADERMAP'] = 'NO'
      config.build_settings['OTHER_CFLAGS'] ||= '$(inherited)'
      config.build_settings['OTHER_CFLAGS'] = [
        '$(inherited)',
        '-fvisibility=hidden',
      ].join(' ')
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= '$(inherited)'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = [
        '$(inherited)',
        '-fvisibility=hidden',
        '-fvisibility-inlines-hidden',
      ].join(' ')

      if target.name == 'whisper_ggml'
        config.build_settings['OTHER_LDFLAGS'] ||= '$(inherited)'
        config.build_settings['OTHER_LDFLAGS'] = [
          '$(inherited)',
          '-Wl,-exported_symbols_list,${PODS_TARGET_SRCROOT}/Classes/whisper_ggml.exports',
        ].join(' ')

        target.source_build_phase.files.each do |build_file|
          path = build_file.file_ref&.path
          next unless path&.end_with?('whisper_flutter_plus.cpp')

          # Override pod-wide hidden visibility for the FFI bridge only.
          build_file.settings = { 'COMPILER_FLAGS' => '-fvisibility=default' }
        end
      elsif target.name == 'llama_ggml'
        config.build_settings['OTHER_LDFLAGS'] ||= '$(inherited)'
        config.build_settings['OTHER_LDFLAGS'] = [
          '$(inherited)',
          '-Wl,-exported_symbols_list,${PODS_TARGET_SRCROOT}/Classes/llama_ggml.exports',
        ].join(' ')

        target.source_build_phase.files.each do |build_file|
          path = build_file.file_ref&.path
          next unless path&.end_with?('llama_ggml.cpp')

          build_file.settings = { 'COMPILER_FLAGS' => '-fvisibility=default' }
        end
      end
    end
  end
end
