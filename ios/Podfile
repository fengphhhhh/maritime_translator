# whisper_ggml's pod requires iOS 15.6; everything else follows it.
platform :ios, '15.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Export Dart FFI symbols after -dead_strip (see WhisperGgmlPlugin / LlamaGgmlPlugin).
RUNNER_FFI_EXPORTS = %w[
  _request
  _stream_start
  _stream_feed
  _stream_stop
  _llama_ggml_load
  _llama_ggml_generate
  _llama_ggml_release
  _llama_ggml_string_free
  _llama_ggml_last_error
  _llama_ggml_devices
].map { |symbol| "-Wl,-exported_symbol,#{symbol}" }.freeze

def append_ldflags!(config, extra_flags)
  existing = config.build_settings['OTHER_LDFLAGS']
  if existing.is_a?(Array)
    config.build_settings['OTHER_LDFLAGS'] = existing + extra_flags
  elsif existing.nil? || existing.to_s.strip.empty?
    config.build_settings['OTHER_LDFLAGS'] = ['$(inherited)', *extra_flags]
  else
    config.build_settings['OTHER_LDFLAGS'] = "#{existing} #{extra_flags.join(' ')}"
  end
end

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Aggregate targets (e.g. "Pods-Runner") have no source_build_phase.
    next if target.is_a?(Xcodeproj::Project::Object::PBXAggregateTarget)

    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.6'

      # Do not set GCC_PREPROCESSOR_DEFINITIONS here. Assigning it at target
      # level shadows the pod's own xcconfig, and whisper_ggml carries
      # GGML_USE_METAL there — losing it would quietly drop inference back to
      # the CPU rather than fail the build.

      next unless ['whisper_ggml', 'llama_ggml'].include?(target.name)

      config.build_settings['USE_HEADERMAP'] = 'NO'
      config.build_settings['OTHER_CFLAGS'] ||= '$(inherited)'
      config.build_settings['OTHER_CFLAGS'] = [
        '$(inherited)',
        '-fvisibility=hidden',
      ].join(' ')
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= '$(inherited)'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = [
        '$(inherited)',
        '-fvisibility=hidden',
        '-fvisibility-inlines-hidden',
      ].join(' ')

      ffi_bridge = case target.name
                   when 'whisper_ggml' then 'whisper_flutter_plus.cpp'
                   when 'llama_ggml' then 'llama_ggml.cpp'
                   end

      target.source_build_phase.files.each do |build_file|
        path = build_file.file_ref&.path
        next unless path&.end_with?(ffi_bridge)

        # FFI entry points need default visibility for dlsym on the app binary.
        build_file.settings = { 'COMPILER_FLAGS' => '-fvisibility=default' }
      end
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |native_target|
      next unless native_target.name == 'Runner'

      native_target.build_configurations.each do |config|
        append_ldflags!(config, RUNNER_FFI_EXPORTS)
      end
    end
    aggregate_target.user_project.save
  end
end
